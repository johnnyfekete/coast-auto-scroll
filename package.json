{
  "name": "coast",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Auto scroll for reading. Installs with no permissions.",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build -b chrome",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "wxt prepare",
    "build:e2e": "COAST_E2E=1 wxt build -b chrome",
    "test:e2e": "npm run build:e2e && playwright test",
    "test:all": "npm run test && npm run test:e2e"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@wxt-dev/module-react": "^1.2.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wxt": "^0.21.3"
  }
}
